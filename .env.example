# Names only. Copy to .env and fill in real values. Never commit .env.
IKANOON_API_KEY=
LLM_API_KEY=            # Gemini (answers; also fallback for router/rewrite)
GROQ_API_KEY=
EMBEDDING_API_KEY=      # Gemini key from a SEPARATE Google project
DATABASE_URL=           # Neon pooled connection string
AUTH_SECRET_KEY=        # long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAILS=           # comma-separated emails allowed to open /admin
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=              # a sender verified at your mail provider
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0           # 1 behind a reverse proxy (Render, Fly, ...)
